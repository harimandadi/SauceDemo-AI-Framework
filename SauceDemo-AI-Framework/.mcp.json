{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "playwright", "mcp",
        "--isolated",
        "--storage-state=playwright/.auth/user.json",
        "--test-id-attribute=data-test"
      ]
    },
    "playwright-test": {
      "command": "npx",
      "args": ["playwright", "run-test-mcp-server"],
      "env": { "PW_AGENTS": "1" }
    }
  }
}
