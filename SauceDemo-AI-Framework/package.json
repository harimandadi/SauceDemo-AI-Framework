{
  "name": "saucedemo-ai-framework",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:guest": "playwright test --project=guest",
    "test:smoke": "playwright test --grep @smoke",
    "test:checkout": "playwright test --grep @checkout --project=chromium",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report",
    "agents:init": "playwright init-agents --loop=claude --project=chromium --prompts",
    "cli:skills": "playwright cli install --skills"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "^22.0.0",
    "dotenv": "^18.0.0",
    "typescript": "^6.0.0"
  }
}
